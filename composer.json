{
    "name": "plutuss/getid3-laravel",
    "description": "Laravel media metadata extraction and upload validation with getID3: audio/video duration, resolution, codecs, ID3 tags and embedded artwork.",
    "keywords": [
        "laravel",
        "getid3",
        "getid3-laravel",
        "audio",
        "mp4",
        "mp3",
        "video",
        "media-metadata",
        "metadata",
        "id3",
        "duration",
        "resolution",
        "upload-validation",
        "laravel-validation"
    ],
    "minimum-stability": "stable",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "plutuss",
            "email": "dima92konovalenko@gmail.com",
            "homepage": "https://github.com/plutuss"
        }
    ],
    "require": {
        "james-heinrich/getid3": "^v2.0.0-beta6",
        "ext-fileinfo": "*",
        "php": "^8.2",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "guzzlehttp/psr7": "^2.6 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Plutuss\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plutuss\\Providers\\GetId3ServiceProvider"
            ]
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Plutuss\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    }
}
